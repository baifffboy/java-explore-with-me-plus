# НАСТРОЙКИ STATS-SERVER

# Порт stats-server на хосте
STATS_SERVER_HOST_PORT=9090
# Порт stats-server внутри контейнера
STATS_SERVER_CONTAINER_PORT=9090
# URL для подключения к stats-db
STATS_DB_URL=jdbc:postgresql://stats-db:5432/ewm_stats
# Данные для подключения к stats-db
STATS_DB_USERNAME=ewm_stats
STATS_DB_PASSWORD=ewm_stats

# НАСТРОЙКИ STATS-DB (PostgreSQL)

# Порт stats-db на хосте
STATS_DB_HOST_PORT=6541
# Порт stats-db внутри контейнера
STATS_DB_CONTAINER_PORT=5432
# Данные для PostgreSQL
STATS_POSTGRES_USER=ewm_stats
STATS_POSTGRES_PASSWORD=ewm_stats
STATS_POSTGRES_DB=ewm_stats

# НАСТРОЙКИ EWM-SERVICE

# Порт ewm-service на хосте
EWM_SERVICE_HOST_PORT=8080
# Порт ewm-service внутри контейнера
EWM_SERVICE_CONTAINER_PORT=8080
# URL для подключения к ewm-db
EWM_DB_URL=jdbc:postgresql://ewm-db:5432/ewm_db
# Данные для подключения к ewm-db
EWM_DB_USERNAME=ewm_db
EWM_DB_PASSWORD=ewm_db
# URL сервиса статистики (для ewm-service)
STATS_SERVER_URL=http://stats-server:9090

# НАСТРОЙКИ EWM-DB (PostgreSQL)

# Порт ewm-db на хосте
EWM_DB_HOST_PORT=6542
# Порт ewm-db внутри контейнера
EWM_DB_CONTAINER_PORT=5432
# Данные для PostgreSQL
EWM_POSTGRES_USER=ewm_db
EWM_POSTGRES_PASSWORD=ewm_db
EWM_POSTGRES_DB=ewm_db